{
  "categories": [
    {
      "name": "Ignored tests",
      "matchedStatuses": ["skipped"],
      "flaky": false
    },
    {
      "name": "Infrastructure problems",
      "matchedStatuses": ["broken", "failed"],
      "messageRegex": ".*ConnectionError.*|.*TimeoutError.*|.*WebDriverException.*",
      "flaky": false
    },
    {
      "name": "Outdated tests",
      "matchedStatuses": ["broken"],
      "traceRegex": ".*FileNotFoundError.*|.*ModuleNotFoundError.*",
      "flaky": false
    },
    {
      "name": "Product defects",
      "matchedStatuses": ["failed"],
      "flaky": false
    },
    {
      "name": "Test defects",
      "matchedStatuses": ["broken"],
      "flaky": false
    },
    {
      "name": "Critical Failures",
      "matchedStatuses": ["failed", "broken"],
      "messageRegex": ".*AssertionError.*|.*Exception.*",
      "flaky": false
    },
    {
      "name": "UI Test Failures",
      "matchedStatuses": ["failed", "broken"],
      "messageRegex": ".*ElementNotVisibleException.*|.*NoSuchElementException.*|.*TimeoutException.*",
      "flaky": false
    },
    {
      "name": "API Test Failures",
      "matchedStatuses": ["failed", "broken"],
      "messageRegex": ".*HTTPError.*|.*RequestException.*|.*JSONDecodeError.*",
      "flaky": false
    },
    {
      "name": "Flaky Tests",
      "matchedStatuses": ["failed", "broken", "passed"],
      "flaky": true
    }
  ]
}
